{
  "expo": {
    "name": "Readcast",
    "slug": "readcast",
    "version": "1.1.0",
    "scheme": "readcast",
    "ios": {
      "bundleIdentifier": "readcast",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/readcast_icon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/readcast_icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Splash_Screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#CEFF41"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/readcast_icon.png",
        "backgroundColor": "#CEFF41"
      },
      "package": "com.polluterofminds.readcast"
    },
    "extra": {
      "eas": {
        "projectId": "aad65c14-8a49-4d9e-9bf2-b50617e73799"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 33,
            "targetSdkVersion": 33,
            "buildToolsVersion": "33.0.0"
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "expo-updates",
        {
          "username": "polluterofminds"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aad65c14-8a49-4d9e-9bf2-b50617e73799"
    }
  }
}
