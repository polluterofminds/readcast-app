{
  "expo": {
    "name": "readstack-app",
    "slug": "readstack-app",
    "version": "1.0.0",
    "scheme": "readcast",
    "ios": {
      "bundleIdentifier": "readcast",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/ReadCastLogoSmall.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/ReadCastLogoSmall.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/ReadCastLogoSmall.png",
      "resizeMode": "contain",
      "backgroundColor": "#181A1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ReadCastLogoSmall.png",
        "backgroundColor": "#181A1A"
      }
    },
    "extra": {
      "eas": {
        "projectId": "0017bbb2-6316-47b8-b973-9e3fb599855d"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 31,
            "targetSdkVersion": 31,
            "buildToolsVersion": "31.0.0"
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ]
  }
}
