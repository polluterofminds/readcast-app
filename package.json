{
  "name": "readcast-app",
  "version": "1.0.1",
  "scripts": {
    "android": "expo run:android",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "tunnel": "expo start --tunnel",
    "web": "expo start --web",
    "ota:prod": "eas update --branch production --message \"Example update\"",
    "ota:preview": "eas update --branch preview --message \"Example update\""
  },
  "dependencies": {
    "@exceptionless/react": "^3.0.5",
    "@neynar/react-native-signin": "^0.2.3",
    "@noble/hashes": "^1.3.3",
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "dayjs": "^1.11.10",
    "expo": "^49.0.21",
    "expo-build-properties": "~0.8.3",
    "expo-linking": "~5.0.2",
    "expo-secure-store": "~12.3.1",
    "expo-splash-screen": "~0.20.5",
    "expo-status-bar": "~1.6.0",
    "expo-updates": "~0.18.19",
    "expo-web-browser": "~12.3.2",
    "glob": "^7.1.7",
    "minimatch": "^3.0.4",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-native": "0.72.6",
    "react-native-dotenv": "^3.4.9",
    "react-native-error-boundary": "^1.2.4",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-get-random-values": "~1.9.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-popup-menu": "^0.16.1",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-svg": "13.9.0",
    "react-native-ui-datepicker": "^1.0.11",
    "react-native-webview": "13.2.2",
    "text-encoding-polyfill": "^0.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.14",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "eslint": "^8.50.0",
    "eslint-config-universe": "^12.0.0",
    "prettier": "^3.0.3",
    "tailwindcss": "3.3.2",
    "typescript": "^5.1.3"
  },
  "eslintConfig": {
    "extends": "universe/native"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-safe-area-context"
      ]
    }
  },
  "private": true
}
